# =============================================================================
# ExamProctor Production Environment Configuration Template
# Instructions:
# 1. Copy this file to .env in your secure production host
# 2. Populate all values with production credentials
# 3. Ensure permissions are restricted: chmod 600 .env
# 4. NEVER commit this file or real credentials to Git!
# =============================================================================

# ── General Runtime Settings ──────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# ── Database (PostgreSQL 15+) ────────────────────────────────────────────────
POSTGRES_USER=examproctor_admin
POSTGRES_PASSWORD=GENERATE_STRONG_DATABASE_PASSWORD_MIN_24_CHARS
POSTGRES_DB=exam_proctor
DATABASE_URL=postgresql://examproctor_admin:GENERATE_STRONG_DATABASE_PASSWORD_MIN_24_CHARS@db:5432/exam_proctor

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis Cache & State ──────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300

# ── Security & Cryptography ──────────────────────────────────────────────────
# Generate key using: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_GENERATED_CRYPTOGRAPHICALLY_SECURE_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Network & Host Protection
ALLOWED_HOSTS=examproctor.yourdomain.com,api.yourdomain.com
ALLOWED_ORIGINS=https://examproctor.yourdomain.com,https://portal.yourdomain.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ── Email / SMTP Notifications ───────────────────────────────────────────────
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=YOUR_SENDGRID_OR_SMTP_PASSWORD
MAIL_FROM=ExamProctor Security <noreply@examproctor.yourdomain.com>
MAIL_TLS=true
MAIL_SSL=false
MOCK_EMAIL=false

# ── External Integrations (Optional) ─────────────────────────────────────────
SERVICENOW_INSTANCE_URL=https://dev00000.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=YOUR_SERVICENOW_PASSWORD

QUESTION_GENERATOR_API_URL=https://api.questiongenerator.ai/v1
QUESTION_GENERATOR_API_KEY=YOUR_API_KEY
